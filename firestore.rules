rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projet partagé par toutes les apps HT Maintenance :
    // lecture/écriture réservées aux comptes connectés (e-mail / mot de passe)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
